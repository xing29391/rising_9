# Bluetooth
bluetooth.device.default_name=Xperia XZ2 Compact

# Display postprocessing
vendor.display.enable_default_color_mode=1
vendor.display.disable_hdr_lut_gen=1

# NFC
ro.vendor.nfc.ko=nxp_pn553_nfc

# Modem config default (Sony modem-switcher reads /vendor/modemconf/<value>/modem.conf);
# without it the modem falls back to non-IMS config and VoLTE never registers after wipe.
persist.vendor.somc.cust.modem0=S285.1
